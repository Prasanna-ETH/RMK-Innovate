# BlindSpot Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Perception & Model Settings
MODEL_NAME=yolov8n.pt
DETECTION_CONFIDENCE=0.35
IOU_THRESHOLD=0.45
TARGET_FPS=15

# Spatial & Path Geometry
SPATIAL_LEFT_BOUNDARY=0.33
SPATIAL_RIGHT_BOUNDARY=0.67
DEPTH_CLOSE_METERS=3.0
PATH_CORRIDOR_LEFT=0.30
PATH_CORRIDOR_RIGHT=0.70
PATH_CORRIDOR_TOP=0.25
PATH_CORRIDOR_BOTTOM=1.0

# Alerting
ALERT_COOLDOWN_SECONDS=2.5
ALERT_REPEAT_DELTA_RISK=18.0
CAMERA_HEIGHT_METERS=1.3
